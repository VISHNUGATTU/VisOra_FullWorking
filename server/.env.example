# VisOra Server Configuration (Patent App No: 202641036876)

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/visora?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key
NODE_ENV=development
PORT=6446

# Frontend
FRONTEND_URL=http://localhost:5173

# Cloudinary (Student & Faculty Profile Biometrics)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Dispatch
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_email_app_password

# VisOra Neural Identity Engine (FastAPI Microservice)
NEURAL_ENGINE_URL=http://localhost:8000
AI_ENGINE_SECRET=VisOra_2026_Secure

# Telegram Bot Reporting (Patent Claim 1f, 8, 10g)
# Note: If omitted, runs in autonomous rich console simulation mode.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_group_or_channel_id
